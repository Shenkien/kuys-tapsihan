# --- Database (Neon Postgres) ---
# Get both from your Neon project dashboard -> Connection Details.
# DATABASE_URL: pooled connection (PgBouncer) - used by the running app.
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require"
# DIRECT_URL: direct (non-pooled) connection - used only by `prisma migrate`.
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Must match your deployed URL on Vercel (or http://localhost:3000 in dev).
NEXTAUTH_URL="http://localhost:3000"

# --- Real-time (Pusher Channels) ---
# Create a free app at pusher.com -> Channels -> your app -> "App Keys".
PUSHER_APP_ID="replace-with-app-id"
PUSHER_KEY="replace-with-key"
PUSHER_SECRET="replace-with-secret"
PUSHER_CLUSTER="ap1"
# Same key/cluster, exposed to the browser (Pusher's app key is not secret —
# it identifies the app, it doesn't authenticate write access).
NEXT_PUBLIC_PUSHER_KEY="replace-with-key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# --- App ---
NODE_ENV="development"
